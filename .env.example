DATABASE_URL=mysql://portal:portal@localhost:3306/portal
# disable | no-verify | verify (managed cloud MySQL usually needs verify + DATABASE_CA_CERT)
DATABASE_SSL=disable
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
UPLOAD_DIR=storage
MAX_UPLOAD_MB=250
PORT=3001
# Optional: enables AI drafting in the document builder
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Public address of the portal (used in email links), e.g. https://bim.example.com
PUBLIC_URL=
# Optional email (SMTP). Without SMTP_HOST, notifications stay in-app and reset links show in the admin console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Daily email digest hour (UTC); SCHEDULER=off disables background jobs
DIGEST_HOUR_UTC=6
# Plans & limits (projects, members, storage, AI requests). Off by default for self-hosted installs.
BILLING=off
