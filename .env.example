DATABASE_URL=mysql://portal:portal@localhost:3306/portal
# disable | no-verify | verify (managed cloud MySQL usually needs verify + DATABASE_CA_CERT)
DATABASE_SSL=disable
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
UPLOAD_DIR=storage
MAX_UPLOAD_MB=250
PORT=3001
# Optional: enables AI drafting in the document builder
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Public address of the portal (used in email links), e.g. https://bim.example.com
PUBLIC_URL=
# Optional email (SMTP). Without SMTP_HOST, notifications stay in-app and reset links show in the admin console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Daily email digest hour (UTC); SCHEDULER=off disables background jobs
DIGEST_HOUR_UTC=6
# Plans & limits (projects, members, storage, AI requests). Off by default for self-hosted installs.
BILLING=off
# AI budget guards. AI_PER_MINUTE: burst limit per user (default 20, 0 = off).
# AI_MONTHLY_LIMIT: requests per user per month when BILLING=off (empty or 0 = no cap; set one for a public launch).
AI_PER_MINUTE=20
AI_MONTHLY_LIMIT=
# Session cookie "Secure" flag. Unset = follow the request (HTTPS behind a proxy that sets X-Forwarded-Proto).
# Set COOKIE_SECURE=true in production when the site is only served over HTTPS.
COOKIE_SECURE=
# Optional card payments (Stripe Checkout). Create two recurring prices in Stripe and a webhook to
# https://<your-domain>/api/stripe/webhook for checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted and invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# AI news feed: "hourly" refreshes the BIM news page in the background (each refresh is a paid web-search request)
NEWS_REFRESH=off
